<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Sheaf.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned: 6.2.4 is the last MIT release. 6.5.0 and later are AGPL-3.0. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFsharp-GDI" Version="6.2.4" />
    <PackageReference Include="PDFsharp-MigraDoc-GDI" Version="6.2.4" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built into the assembly, so a missing file can never stop the app from opening. -->
    <EmbeddedResource Include="Assets\Fonts\*.ttf" LogicalName="Fonts.%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="Sheaf.Core.Tests" />
  </ItemGroup>

</Project>
